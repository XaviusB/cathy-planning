<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CathyPlanning.App.MainWindow"
        Title="Cathy Planning"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600">

  <DockPanel>
    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                Background="#F0F4F8" Margin="0,0,0,2">
      <Button Name="BtnNew" Content="New" Margin="8,4,0,4" />
      <Button Name="BtnOpen" Content="Open…" Margin="0,4" />
      <Button Name="BtnSave" Content="Save…" Margin="0,4" />
      <Separator Width="1" Margin="4,4" Background="#CCC" />
      <Button Name="BtnGenerate" Content="Auto-Generate" Margin="0,4" />
      <Separator Width="1" Margin="4,4" Background="#CCC" />
      <Button Name="BtnPrev" Content="◀" Width="32" Margin="0,4" />
      <TextBlock Name="TxtWeekLabel" VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold" />
      <Button Name="BtnNext" Content="▶" Width="32" Margin="0,4" />
    </StackPanel>

    <!-- Right panel -->
    <Border DockPanel.Dock="Right" Width="280" Background="#FAFAFA"
            BorderBrush="#DDD" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="12">
          <TextBlock Text="Worked Hours" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
          <TextBlock Name="TxtHours" TextWrapping="Wrap" />
          <Separator Margin="0,10" />
          <TextBlock Text="Compliance" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
          <TextBlock Name="TxtCompliance" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Calendar area -->
    <Grid Name="CalendarRoot">
      <!-- Employee row headers column -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Day headers + employee rows (drawn in code-behind) -->
      <Canvas Name="CalendarCanvas" Grid.Column="0" Grid.ColumnSpan="2"
              ClipToBounds="True" />
    </Grid>
  </DockPanel>
</Window>
