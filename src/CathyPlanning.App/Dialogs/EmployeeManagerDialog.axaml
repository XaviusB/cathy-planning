<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CathyPlanning.App.Dialogs.EmployeeManagerDialog"
        Title="Manage People"
        Width="680" Height="420"
        MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <!-- Add row at bottom -->
    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Name="TxtNewName"     Watermark="Name"          Width="120" />
        <TextBox Name="TxtNewRole"     Watermark="Role"          Width="100" />
        <TextBox Name="TxtNewHours"    Watermark="Max h/wk"      Width="75"  />
        <TextBox Name="TxtNewWkRest"   Watermark="Min rest h/wk" Width="100" />
        <Button  Name="BtnAdd"         Content="Add"             />
      </StackPanel>
    </Border>

    <!-- Employee list -->
    <ScrollViewer>
      <StackPanel Name="EmpList" Spacing="4" />
    </ScrollViewer>
  </DockPanel>
</Window>
