{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Start development server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "action": "openIntegratedBrowser",
        "pattern": "Serveur démarré sur (https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
